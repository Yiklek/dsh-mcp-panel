{
  "name": "dsh-mcp-panel",
  "version": "0.1.0",
  "description": "DSH web plugin: manage MCP servers for the official @deepseek-ai/dsh-mcp-client. One config surface for global (DSH_HOME/yiklek/mcp.json) and workspace-level (<workspace>/.dsh/yiklek/mcp.json) servers, importing and exporting the mainstream MCP config shapes.",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "locale/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:playwright": "node tests/playwright/panel.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "mcp",
    "model-context-protocol",
    "mcp-server"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
